---
import { siteConfig } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/");
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111216" />
    <title>{title} · {siteConfig.title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-inner">
        <a class="brand" href={base}>{siteConfig.title}</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">Menu</button>
        <nav class="nav-links" id="primary-navigation" aria-label="Main navigation" data-open="false">
          {siteConfig.navigation.map((item) => (
            <a href={`${base}${item.href.replace(/^\//, "")}`} aria-current={currentPath === item.href || (item.href === "/projects/" && currentPath.startsWith("/projects")) ? "page" : undefined}>{item.label}</a>
          ))}
          <a href={siteConfig.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} · {siteConfig.title}</span>
        <div class="footer-links">
          <a href={`${base}projects/`}>Projects</a>
          <a href={`${base}about/`}>About</a>
          <a href={`${base}contact/`}>Contact</a>
          <a href={siteConfig.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#primary-navigation");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        nav?.setAttribute("data-open", String(open));
      });
    </script>
  </body>
</html>
