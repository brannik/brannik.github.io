---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      category: string;
      status: string;
      technologies: string[];
      cover: string;
    };
  };
  featured?: boolean;
}
const { project } = Astro.props;
const { data, id } = project;
const base = import.meta.env.BASE_URL;
const imagePath = `${base}${data.cover.replace(/^\//, "")}`;
---
<a class="project-card" href={`${base}projects/${id}/`} data-project-card data-category={data.category} data-search={`${data.title} ${data.description} ${data.category} ${data.technologies.join(" ")}`.toLowerCase()}>
  <div class="project-image">
    <img src={imagePath} alt={`${data.title} project preview`} loading="lazy" />
  </div>
  <div class="project-content">
    <div class="project-meta">
      <span>{data.category}</span>
      <span>·</span>
      <span><span class="status-dot"></span>{data.status}</span>
    </div>
    <h3>{data.title}</h3>
    <p>{data.description}</p>
    <div class="tag-list">
      {data.technologies.slice(0, 4).map((technology) => <span class="tag">{technology}</span>)}
    </div>
  </div>
</a>
