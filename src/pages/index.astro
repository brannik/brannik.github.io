---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";
import { homepageConfig } from "../config/homepage";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured);
const preview = projects.slice(0, homepageConfig.projectPreviewCount);
const base = import.meta.env.BASE_URL;
---
<MainLayout>
  {homepageConfig.showHero && <section class="container hero">
    <p class="eyebrow">Personal portfolio · Selected work</p>
    <h1>Building things.<br /><span class="accent-text">Exploring ideas.</span></h1>
    <p class="lead">{siteConfig.introduction}</p>
    <div class="button-row">
      <a class="button button-primary" href={`${base}projects/`}>Explore projects <span aria-hidden="true">↗</span></a>
      <a class="button" href={siteConfig.githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>}
  {homepageConfig.showFeaturedProjects && featured.length > 0 && <section class="container section">
    <div class="section-heading">
      <div><p class="eyebrow">A closer look</p><h2>Featured projects</h2><p>A few selected things I've been working on.</p></div>
      <a class="text-link" href={`${base}projects/`}>All projects ↗</a>
    </div>
    <div class="project-grid">{featured.map((project) => <ProjectCard project={project} />)}</div>
  </section>}
  {homepageConfig.showAllProjectsPreview && <section class="container section">
    <div class="section-heading">
      <div><p class="eyebrow">The catalogue</p><h2>More projects</h2><p>Browse software, hardware and experiments.</p></div>
      <a class="text-link" href={`${base}projects/`}>Browse catalogue ↗</a>
    </div>
    <div class="project-grid">{preview.map((project) => <ProjectCard project={project} />)}</div>
  </section>}
  {homepageConfig.showAboutPreview && <section class="container section">
    <div class="content-panel">
      <p class="eyebrow">A little about this space</p>
      <h2 style="font-size:30px;letter-spacing:-.04em;margin:10px 0">Curiosity turned into projects.</h2>
      <p class="lead">A place to collect practical builds, experiments, tools and ideas — with the details behind each one.</p>
      <a class="text-link" href={`${base}about/`}>More about me ↗</a>
    </div>
  </section>}
  {homepageConfig.showContactSection && <section class="container section">
    <div class="section-heading">
      <div><p class="eyebrow">Get in touch</p><h2>Have something in mind?</h2><p>Questions, ideas or opportunities are always welcome.</p></div>
      <a class="button" href={`${base}contact/`}>Contact ↗</a>
    </div>
  </section>}
</MainLayout>
