---
import MainLayout from "../../layouts/MainLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
const links = project.data.links;
---
<MainLayout title={project.data.title} description={project.data.description}>
  <article class="container">
    <header class="project-detail-hero">
      <p class="eyebrow">{project.data.category} · {project.data.status}</p>
      <h1>{project.data.title}</h1>
      <p class="lead">{project.data.description}</p>
      <div class="tag-list">{project.data.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
      <div class="button-row">
        {links.github && <a class="button button-primary" href={links.github} target="_blank" rel="noreferrer">GitHub repository ↗</a>}
        {links.demo && <a class="button" href={links.demo} target="_blank" rel="noreferrer">Live demo ↗</a>}
        {links.documentation && <a class="button" href={links.documentation} target="_blank" rel="noreferrer">Documentation ↗</a>}
      </div>
    </header>
    <img class="detail-cover" src={asset(project.data.cover)} alt={`${project.data.title} cover image`} />
    <section class="section">
      <div class="prose"><Content /></div>
      {project.data.gallery.length > 0 && <>
        <div class="section-heading" style="margin-top:48px"><div><p class="eyebrow">Visual tour</p><h2>Gallery</h2></div></div>
        <div class="gallery-grid">
          {project.data.gallery.map((item) => <button class="gallery-item" type="button" data-gallery-item data-caption={item.caption ?? item.alt}>
            <img src={asset(item.src)} alt={item.alt} loading="lazy" />
            {item.caption && <span class="gallery-caption">{item.caption}</span>}
          </button>)}
        </div>
      </>}
    </section>
    <div style="padding-bottom:64px"><a class="text-link" href={`${base}projects/`}>← Back to all projects</a></div>
  </article>
  {project.data.gallery.length > 0 && <Lightbox />}
</MainLayout>
